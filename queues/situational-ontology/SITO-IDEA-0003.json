  "design_constraints": [
    "Compositions have identities distinct from prompts; composition is not itself an instruction.",
    "Multiple situations and intents may be reused without duplicating formal objects.",
    "Mappings are provisional union-of-generations rather than assertions about each version.",
    "Existing SIT-0001 through SIT-0008 remain canonical prompt family anchors until explicit migration."
  ],
