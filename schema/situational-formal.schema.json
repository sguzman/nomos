{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/nomos/blob/main/schema/situational-formal.schema.json",
  "title": "Formal situational ontology records",
  "description": "Independently versioned reusable objects: situations, intent concepts, compositions, conditions and evaluation dimensions. None auto-applies instructions.",
  "oneOf": [
    {
      "$ref": "#/$defs/situation"
    },
    {
      "$ref": "#/$defs/intent"
    },
    {
      "$ref": "#/$defs/intent_family"
    },
    {
      "$ref": "#/$defs/execution_condition"
    },
    {
      "$ref": "#/$defs/evaluation_dimension"
    }
  ],
  "$defs": {
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "status",
        "code",
        "definition",
        "classification",
        "component_situation_ids",
        "related_prompt_families",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SITU-[0-9]{4}$"
        },
        "kind": {
          "const": "situation"
        },
        "version": {
          "const": "1.0.0"
        },
        "status": {
          "const": "published"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "event",
            "composite",
            "execution_state"
          ]
        },
        "component_situation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SITU-[0-9]{4}$"
          }
        },
        "related_prompt_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SIT-[0-9]{4}$"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queue_id",
            "source_candidate"
          ],
          "properties": {
            "queue_id": {
              "type": "string",
              "pattern": "^SITO-IDEA-000[1-6]$"
            },
            "source_candidate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "status",
        "code",
        "definition",
        "semantic_role",
        "atomicity",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^INTENT-[0-9]{4}$"
        },
        "kind": {
          "const": "intent"
        },
        "version": {
          "const": "1.0.0"
        },
        "status": {
          "const": "published"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "semantic_role": {
          "enum": [
            "goal",
            "method",
            "constraint",
            "reporting",
            "stopping_policy"
          ]
        },
        "atomicity": {
          "enum": [
            "single_intent_candidate",
            "composite_method",
            "compound_policy",
            "composite_report"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queue_id",
            "source_candidate"
          ],
          "properties": {
            "queue_id": {
              "type": "string",
              "pattern": "^SITO-IDEA-000[1-6]$"
            },
            "source_candidate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "intent_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "status",
        "code",
        "description",
        "canonical_prompt_id",
        "situation_ids",
        "condition_ids",
        "intent_ids",
        "version_intent_ids",
        "versions",
        "default_version",
        "interpretation_note",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FAMILY-[0-9]{4}$"
        },
        "kind": {
          "const": "intent_family"
        },
        "version": {
          "const": "1.0.0"
        },
        "status": {
          "const": "published"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "canonical_prompt_id": {
          "type": "string",
          "pattern": "^SIT-[0-9]{4}$"
        },
        "situation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SITU-[0-9]{4}$"
          }
        },
        "condition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CONDITION-[0-9]{4}$"
          }
        },
        "intent_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^INTENT-[0-9]{4}$"
          }
        },
        "version_intent_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1.0.0",
            "2.0.0",
            "3.0.0"
          ],
          "properties": {
            "1.0.0": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^INTENT-[0-9]{4}$"
              }
            },
            "2.0.0": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^INTENT-[0-9]{4}$"
              }
            },
            "3.0.0": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^INTENT-[0-9]{4}$"
              }
            }
          }
        },
        "versions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "1.0.0",
              "2.0.0",
              "3.0.0"
            ]
          }
        },
        "default_version": {
          "const": "1.0.0"
        },
        "interpretation_note": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queue_id",
            "source_candidate"
          ],
          "properties": {
            "queue_id": {
              "type": "string",
              "pattern": "^SITO-IDEA-000[1-6]$"
            },
            "source_candidate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "execution_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "status",
        "code",
        "definition",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CONDITION-[0-9]{4}$"
        },
        "kind": {
          "const": "execution_condition"
        },
        "version": {
          "const": "1.0.0"
        },
        "status": {
          "const": "published"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queue_id",
            "source_candidate"
          ],
          "properties": {
            "queue_id": {
              "type": "string",
              "pattern": "^SITO-IDEA-000[1-6]$"
            },
            "source_candidate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evaluation_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "status",
        "code",
        "definition",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVAL-DIM-[0-9]{4}$"
        },
        "kind": {
          "const": "evaluation_dimension"
        },
        "version": {
          "const": "1.0.0"
        },
        "status": {
          "const": "published"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queue_id",
            "source_candidate"
          ],
          "properties": {
            "queue_id": {
              "type": "string",
              "pattern": "^SITO-IDEA-000[1-6]$"
            },
            "source_candidate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
