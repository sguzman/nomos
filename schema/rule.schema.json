{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/nomos/blob/main/schema/rule.schema.json",
  "title": "Nomos rule record 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "summary",
    "statement",
    "rationale",
    "language",
    "status",
    "norm",
    "categories",
    "scope",
    "authority",
    "relations",
    "provenance",
    "governance",
    "export_targets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NOM-[0-9]{4,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published",
        "deprecated"
      ]
    },
    "norm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "predicate",
        "permission_strength",
        "conditions",
        "exceptions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "prohibition",
            "obligation",
            "permission"
          ]
        },
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "object",
            "target"
          ],
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1
            },
            "object": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "permission_strength": {
          "enum": [
            "strong",
            "weak",
            "not_applicable"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "topics",
        "audiences"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "privacy",
              "publication",
              "personal_writing",
              "software_development",
              "agent_instructions",
              "governance"
            ]
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "information_disclosure",
              "content_handling",
              "personal_expression",
              "rule_composition"
            ]
          }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ai_agents",
              "human_authors",
              "automations",
              "general"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes",
        "preconditions",
        "exclusions"
      ],
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "visibility",
            "artifact_kind",
            "actor"
          ],
          "properties": {
            "channel": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "git_repository",
                  "local_workspace",
                  "chat",
                  "website"
                ]
              }
            },
            "visibility": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "public",
                  "private",
                  "internal"
                ]
              }
            },
            "artifact_kind": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "repository_content",
                  "diary",
                  "instructions",
                  "document"
                ]
              }
            },
            "actor": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "ai_agent",
                  "human",
                  "automation"
                ]
              }
            }
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tier",
        "priority",
        "override_policy"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "repository_policy",
            "use_case_policy",
            "general_guidance",
            "example"
          ]
        },
        "priority": {
          "type": "integer"
        },
        "override_policy": {
          "enum": [
            "explicit_resolution",
            "non_overridable_within_scope"
          ]
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflicts_with",
        "exceptions_to",
        "refines",
        "depends_on"
      ],
      "properties": {
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "exceptions_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "refines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "reference",
        "license",
        "notes"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "authored",
            "public_document",
            "synthetic_example"
          ]
        },
        "reference": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_on",
        "updated_on",
        "review_status"
      ],
      "properties": {
        "created_on": {
          "type": "string",
          "format": "date"
        },
        "updated_on": {
          "type": "string",
          "format": "date"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "editorial_reviewed",
            "approved",
            "retired"
          ]
        }
      }
    },
    "export_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "agents_md",
          "chatgpt_custom_instructions",
          "plain_text"
        ]
      }
    }
  }
}
