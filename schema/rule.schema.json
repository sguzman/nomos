{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/nomos/blob/main/schema/rule.schema.json",
  "title": "Nomos rule record 1.1 — explicit quantification and bounds",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "summary",
    "statement",
    "rationale",
    "language",
    "status",
    "norm",
    "categories",
    "scope",
    "authority",
    "relations",
    "provenance",
    "governance",
    "export_targets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NOM-[0-9]{4,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published",
        "deprecated"
      ]
    },
    "norm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "predicate",
        "permission_strength",
        "conditions",
        "exceptions",
        "bounds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "prohibition",
            "obligation",
            "permission"
          ]
        },
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "object",
            "target"
          ],
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1
            },
            "object": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "permission_strength": {
          "enum": [
            "strong",
            "weak",
            "not_applicable"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value_constraint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "operator"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "equals",
                "latest_stable_supported"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "equals"
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "latest_stable_supported"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            }
          ]
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "description": "Independent lexical quantifier, interpreted meaning, frequency and numeric limits. Unreviewed historical rules retain unresolved values rather than guessed quantification.",
          "required": [
            "quantifier",
            "interpretation",
            "frequency",
            "minimum",
            "maximum",
            "unit",
            "window",
            "cue",
            "basis"
          ],
          "properties": {
            "quantifier": {
              "enum": [
                "all",
                "any",
                "some",
                "none",
                "unspecified"
              ],
              "description": "Recorded quantity wording: any is ambiguous without interpretation."
            },
            "interpretation": {
              "enum": [
                "universal",
                "existential",
                "free_choice",
                "zero",
                "unspecified"
              ],
              "description": "Reviewed logical reading, independent of lexical wording and deontic kind."
            },
            "frequency": {
              "enum": [
                "always",
                "never",
                "sometimes",
                "unspecified"
              ],
              "description": "Occurrence/frequency modality within the applicable scope."
            },
            "minimum": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Minimum permissible or required count if explicitly bounded; null is unknown."
            },
            "maximum": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Maximum permissible or required count if explicitly bounded; null is unbounded or unknown, not infinity."
            },
            "unit": {
              "enum": [
                "occurrences",
                "entities",
                "unspecified"
              ]
            },
            "window": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Time/event window in public-safe text, null if unspecified."
            },
            "cue": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Source cue or short literal anchor supporting the interpretation; never a private excerpt."
            },
            "basis": {
              "enum": [
                "explicit_text",
                "reviewed_inference",
                "unresolved"
              ],
              "description": "Whether bounds were explicitly stated, carefully interpreted, or not yet normalized."
            }
          }
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "topics",
        "audiences"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "agent_instructions",
              "ci_cd",
              "documentation",
              "git_repository",
              "governance",
              "ontology",
              "personal_writing",
              "privacy",
              "project_management",
              "publication",
              "qa_verification",
              "releases",
              "rust_development",
              "rust_quality",
              "safety_integrity",
              "software_development",
              "software_porting",
              "user_interfaces",
              "visual_identity",
              "workflow_governance"
            ]
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "completion_reporting",
              "content_handling",
              "development_hygiene",
              "edition_selection",
              "identity_color",
              "implementation_language",
              "information_disclosure",
              "personal_expression",
              "port_fidelity",
              "port_mvp",
              "post_mvp_scope",
              "progress_reporting",
              "project_roadmap",
              "readme_identity",
              "representation",
              "rule_composition",
              "specimen_showcase",
              "theme_control",
              "workflow_stage"
            ]
          }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ai_agents",
              "human_authors",
              "automations",
              "general"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes",
        "preconditions",
        "exclusions"
      ],
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "visibility",
            "artifact_kind",
            "actor"
          ],
          "properties": {
            "channel": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "git_repository",
                  "local_workspace",
                  "chat",
                  "website"
                ]
              }
            },
            "visibility": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "public",
                  "private",
                  "internal"
                ]
              }
            },
            "artifact_kind": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "cargo_manifest",
                  "diary",
                  "document",
                  "gui",
                  "instructions",
                  "ontology",
                  "project_roadmap",
                  "repository_content",
                  "website"
                ]
              }
            },
            "actor": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "ai_agent",
                  "human",
                  "automation"
                ]
              }
            }
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tier",
        "priority",
        "override_policy"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "repository_policy",
            "use_case_policy",
            "general_guidance",
            "example"
          ]
        },
        "priority": {
          "type": "integer"
        },
        "override_policy": {
          "enum": [
            "explicit_resolution",
            "non_overridable_within_scope"
          ]
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflicts_with",
        "exceptions_to",
        "refines",
        "depends_on"
      ],
      "properties": {
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "exceptions_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "refines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "reference",
        "license",
        "notes"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "authored",
            "public_document",
            "synthetic_example"
          ]
        },
        "reference": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_on",
        "updated_on",
        "review_status"
      ],
      "properties": {
        "created_on": {
          "type": "string",
          "format": "date"
        },
        "updated_on": {
          "type": "string",
          "format": "date"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "editorial_reviewed",
            "approved",
            "retired"
          ]
        }
      }
    },
    "export_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "agents_md",
          "chatgpt_custom_instructions",
          "plain_text"
        ]
      }
    }
  }
}
