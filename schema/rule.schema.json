{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/nomos/blob/main/schema/rule.schema.json",
  "title": "Nomos rule record 1.1 — explicit quantification and bounds",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "summary",
    "statement",
    "rationale",
    "language",
    "status",
    "norm",
    "categories",
    "scope",
    "authority",
    "relations",
    "provenance",
    "governance",
    "export_targets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NOM-[0-9]{4,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published",
        "deprecated"
      ]
    },
    "norm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "predicate",
        "permission_strength",
        "conditions",
        "exceptions",
        "bounds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "prohibition",
            "obligation",
            "permission"
          ]
        },
        "predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "object",
            "target"
          ],
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1
            },
            "object": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "permission_strength": {
          "enum": [
            "strong",
            "weak",
            "not_applicable"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value_constraint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "operator"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "equals",
                "latest_stable_supported"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "equals"
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "latest_stable_supported"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            }
          ]
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "description": "Independent lexical quantifier, interpreted meaning, frequency and numeric limits. Unreviewed historical rules retain unresolved values rather than guessed quantification.",
          "required": [
            "quantifier",
            "interpretation",
            "frequency",
            "minimum",
            "maximum",
            "unit",
            "window",
            "cue",
            "basis"
          ],
          "properties": {
            "quantifier": {
              "enum": [
                "all",
                "any",
                "some",
                "none",
                "unspecified"
              ],
              "description": "Recorded quantity wording: any is ambiguous without interpretation."
            },
            "interpretation": {
              "enum": [
                "universal",
                "existential",
                "free_choice",
                "zero",
                "unspecified"
              ],
              "description": "Reviewed logical reading, independent of lexical wording and deontic kind."
            },
            "frequency": {
              "enum": [
                "always",
                "never",
                "sometimes",
                "unspecified"
              ],
              "description": "Occurrence/frequency modality within the applicable scope."
            },
            "minimum": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Minimum permissible or required count if explicitly bounded; null is unknown."
            },
            "maximum": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Maximum permissible or required count if explicitly bounded; null is unbounded or unknown, not infinity."
            },
            "unit": {
              "enum": [
                "occurrences",
                "entities",
                "unspecified"
              ]
            },
            "window": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Time/event window in public-safe text, null if unspecified."
            },
            "cue": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Source cue or short literal anchor supporting the interpretation; never a private excerpt."
            },
            "basis": {
              "enum": [
                "explicit_text",
                "reviewed_inference",
                "unresolved"
              ],
              "description": "Whether bounds were explicitly stated, carefully interpreted, or not yet normalized."
            }
          }
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "topics",
        "audiences"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "agent_instructions",
              "ci_cd",
              "data_integrity",
              "dependency_management",
              "documentation",
              "git_repository",
              "governance",
              "maintenance",
              "ontology",
              "personal_writing",
              "privacy",
              "project_architecture",
              "project_management",
              "publication",
              "qa_verification",
              "releases",
              "rust_development",
              "rust_quality",
              "safety_integrity",
              "security",
              "software_development",
              "software_porting",
              "software_testing",
              "user_interfaces",
              "visual_identity",
              "workflow_governance"
            ]
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "acceptance_criteria",
              "architecture_documentation",
              "artifact_hashing",
              "artifact_packaging",
              "backward_compatibility",
              "branch_policy",
              "browser_artifact_versioning",
              "browser_extension_version",
              "browser_userscript_version",
              "change_scope",
              "changelog",
              "ci_configuration",
              "ci_quality_gates",
              "ci_repair",
              "ci_result_verification",
              "ci_triggers",
              "ci_workflows",
              "cli_help",
              "commit_quality",
              "committed_state_verification",
              "completion_evidence",
              "completion_reporting",
              "configuration_documentation",
              "content_handling",
              "cross_platform_ci",
              "data_roundtrip",
              "deployment_workflows",
              "deterministic_testing",
              "development_hygiene",
              "differential_testing",
              "documentation_audit",
              "edge_case_testing",
              "edition_selection",
              "evidence_based_status",
              "git_history_verification",
              "gui_browser_testing",
              "gui_theme_support",
              "identity_color",
              "identity_colors",
              "ignore_file_maintenance",
              "implementation_language",
              "inaugural_distribution",
              "inaugural_release",
              "inaugural_release_verification",
              "inaugural_version",
              "information_disclosure",
              "integration_testing",
              "job_script_invocation",
              "job_script_placement",
              "license_compliance",
              "local_job_path",
              "lockfile_integrity",
              "mvp_acceptance",
              "mvp_api_consumer",
              "mvp_authorization_boundary",
              "mvp_baseline",
              "mvp_ci_gate",
              "mvp_compatibility",
              "mvp_defect_gate",
              "mvp_definition",
              "mvp_documentation",
              "mvp_end_to_end_testing",
              "mvp_environment_verification",
              "mvp_evidence_record",
              "mvp_evidence_standard",
              "mvp_inauguration",
              "mvp_installation",
              "mvp_invalid_acceptance",
              "mvp_owner_approval",
              "mvp_scope_boundary",
              "naming_restrictions",
              "ontology_gallery",
              "ontology_representation",
              "personal_expression",
              "port_coverage_inventory",
              "port_fidelity",
              "port_mvp",
              "post_mvp_compatibility",
              "post_mvp_releases",
              "post_mvp_scope",
              "private_public_boundary",
              "progress_reporting",
              "project_roadmap",
              "public_privacy_review",
              "readme_identity",
              "readme_maintenance",
              "regression_testing",
              "release_automation",
              "release_readiness",
              "release_tagging",
              "repository_clone_policy",
              "repository_inspection",
              "repository_path_integrity",
              "repository_sync",
              "representation",
              "roadmap_status",
              "roadmap_structure",
              "rule_composition",
              "rust_compilation",
              "rust_formatting",
              "rust_linting",
              "rust_port_coverage",
              "rust_port_differential",
              "rust_port_unsafe_ffi",
              "rust_preference",
              "safe_operations",
              "scaffold_cleanup",
              "secret_management",
              "semantic_versioning",
              "smoke_testing",
              "source_provenance",
              "specimen_showcase",
              "specimen_task_workflow",
              "strict_port_fidelity",
              "synthetic_test_fixtures",
              "target_feature_testing",
              "tarium_admission_preflight",
              "tarium_autonomy",
              "tarium_externalization",
              "tarium_gallery",
              "tarium_gallery_integrity",
              "tarium_governance",
              "tarium_interoperation",
              "tarium_manifest_consistency",
              "tarium_membership",
              "tarium_ontology",
              "tarium_ontology_evolution",
              "tarium_public_boundary",
              "tarium_publication_review",
              "tarium_reproducibility",
              "theme_control",
              "unfinished_work_state",
              "unit_testing",
              "unsafe_ffi_containment",
              "unwarranted_safety_checkin_repetition",
              "version_consistency",
              "workflow_stage",
              "yaml_error_propagation",
              "yaml_job_workflow",
              "yaml_script_size"
            ]
          }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ai_agents",
              "human_authors",
              "automations",
              "general"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes",
        "preconditions",
        "exclusions"
      ],
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "visibility",
            "artifact_kind",
            "actor"
          ],
          "properties": {
            "channel": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "git_repository",
                  "local_workspace",
                  "chat",
                  "website"
                ]
              }
            },
            "visibility": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "public",
                  "private",
                  "internal"
                ]
              }
            },
            "artifact_kind": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "cargo_manifest",
                  "diary",
                  "document",
                  "gui",
                  "instructions",
                  "ontology",
                  "project_roadmap",
                  "repository_content",
                  "website"
                ]
              }
            },
            "actor": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "any",
                  "ai_agent",
                  "human",
                  "automation"
                ]
              }
            }
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "any",
              "project",
              "software_project",
              "software_port",
              "rust_project",
              "rust_project_from_scratch",
              "rust_fork_maintenance",
              "c_to_rust_port",
              "browser_userscript",
              "browser_extension",
              "tarium_project"
            ]
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tier",
        "priority",
        "override_policy"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "repository_policy",
            "use_case_policy",
            "general_guidance",
            "example"
          ]
        },
        "priority": {
          "type": "integer"
        },
        "override_policy": {
          "enum": [
            "explicit_resolution",
            "non_overridable_within_scope"
          ]
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflicts_with",
        "exceptions_to",
        "refines",
        "depends_on"
      ],
      "properties": {
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "exceptions_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "refines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "reference",
        "license",
        "notes"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "authored",
            "public_document",
            "synthetic_example"
          ]
        },
        "reference": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_on",
        "updated_on",
        "review_status"
      ],
      "properties": {
        "created_on": {
          "type": "string",
          "format": "date"
        },
        "updated_on": {
          "type": "string",
          "format": "date"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "editorial_reviewed",
            "approved",
            "retired"
          ]
        }
      }
    },
    "export_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "agents_md",
          "chatgpt_custom_instructions",
          "plain_text"
        ]
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "aliases"
      ],
      "properties": {
        "concept": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  }
}
