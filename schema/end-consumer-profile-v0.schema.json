{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "End-consumer prompt profile, V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "name",
    "visibility",
    "lifecycle",
    "created_on",
    "current_version",
    "versions",
    "slots",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "end_consumer_prompt_profile"
    },
    "id": {
      "type": "string",
      "pattern": "^EC-PROFILE-[0-9]{4,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "const": "public"
    },
    "lifecycle": {
      "const": "draft_v0"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "current_version": {
      "const": "0"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "source_format",
          "source_path",
          "source_sha256",
          "source_git_blob_sha1",
          "source_trievium_version"
        ],
        "properties": {
          "version": {
            "const": "0"
          },
          "source_format": {
            "const": "trievium"
          },
          "source_path": {
            "const": "v0/trievium.json"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_git_blob_sha1": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_trievium_version": {
            "const": 1
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ordinal",
          "key",
          "label",
          "text_sha256",
          "version",
          "semantic_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EC-PROMPT-[0-9]{4,}$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "const": "0"
          },
          "semantic_status": {
            "const": "not_analyzed"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_import_authorized",
        "semantic_enrichment_authorized",
        "copy_requires_user_action",
        "export_requires_user_action",
        "selected_replacement_versions",
        "note"
      ],
      "properties": {
        "source_import_authorized": {
          "const": true
        },
        "semantic_enrichment_authorized": {
          "const": false
        },
        "copy_requires_user_action": {
          "const": true
        },
        "export_requires_user_action": {
          "const": true
        },
        "selected_replacement_versions": {
          "type": "array",
          "maxItems": 0
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
