{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/nomos/blob/main/schema/situational-processing.schema.json",
  "title": "Situational prompt normalization trace",
  "description": "Auditable intake normalization with independently authorized publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "intake_id",
    "output_prompt_id",
    "authorization",
    "disposition",
    "publication",
    "source_handling",
    "governance",
    "publication_authorization"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PROC-SIT-IDEA-[0-9]{4,}$"
    },
    "kind": {
      "const": "situational_prompt_processing"
    },
    "intake_id": {
      "type": "string",
      "pattern": "^SIT-IDEA-[0-9]{4,}$"
    },
    "output_prompt_id": {
      "type": "string",
      "pattern": "^SIT-[0-9]{4,}$"
    },
    "authorization": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "const": "normalized_to_reviewed_entry"
    },
    "publication": {
      "enum": [
        "awaiting_separate_owner_approval",
        "owner_approved",
        "rejected"
      ]
    },
    "source_handling": {
      "type": "string",
      "minLength": 1
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processed_on",
        "recorded_by"
      ],
      "properties": {
        "processed_on": {
          "type": "string",
          "format": "date"
        },
        "recorded_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publication_authorization": {
      "type": [
        "string",
        "null"
      ],
      "description": "Public-safe evidence of separate owner publication authorization, null until approval."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication": {
            "const": "owner_approved"
          }
        }
      },
      "then": {
        "properties": {
          "publication_authorization": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "enum": [
              "awaiting_separate_owner_approval",
              "rejected"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "publication_authorization": {
            "type": "null"
          }
        }
      }
    }
  ]
}
