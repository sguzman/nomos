{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/nomos/blob/main/schema/situational-prompt-revision.schema.json",
  "title": "Queued revision of an existing situational prompt",
  "description": "An inert, version-linked candidate for an already published canonical situational prompt. Queueing is not processing or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "canonical_prompt_id",
    "situation_code",
    "status",
    "proposed_version",
    "base_published_version",
    "predecessor_ref",
    "source",
    "proposed_text",
    "review",
    "governance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SIT-REV-[0-9]{4}-[0-9]{2}$"
    },
    "kind": {
      "const": "situational_prompt_revision"
    },
    "canonical_prompt_id": {
      "type": "string",
      "pattern": "^SIT-[0-9]{4}$"
    },
    "situation_code": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "deferred",
        "cancelled",
        "processed"
      ]
    },
    "proposed_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "base_published_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "predecessor_ref": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "artifact_version",
        "entry_ordinal",
        "content_sha256"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+\\.json$"
        },
        "artifact_version": {
          "type": "integer",
          "minimum": 1
        },
        "entry_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "proposed_text": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_authorized",
        "publication_authorized",
        "flags"
      ],
      "properties": {
        "processing_authorized": {
          "type": "boolean"
        },
        "publication_authorized": {
          "type": "boolean"
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "reinforcement_to_execution_requires_review",
              "blocker_handoff_policy_review"
            ]
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_on",
        "updated_on"
      ],
      "properties": {
        "created_on": {
          "type": "string",
          "format": "date"
        },
        "updated_on": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "processed"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "processing_authorized": {
                "const": true
              },
              "publication_authorized": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "deferred",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "processing_authorized": {
                "const": false
              },
              "publication_authorized": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
