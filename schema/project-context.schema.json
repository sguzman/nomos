{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/nomos/blob/main/schema/project-context.schema.json",
  "title": "Nomos project facts for a derived rule projection",
  "description": "Only explicit typed facts. Missing and unknown are not affirmative. This is not a permission record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "project_types",
    "types_exhaustive",
    "phase",
    "axes",
    "features"
  ],
  "properties": {
    "kind": {
      "const": "project_context"
    },
    "version": {
      "const": "1.0.0"
    },
    "project_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "types_exhaustive": {
      "type": "boolean",
      "description": "True only if the owner has explicitly answered all relevant overlapping project-type facets."
    },
    "phase": {
      "enum": [
        "planning",
        "implementation",
        "testing",
        "release",
        "maintenance",
        "unspecified"
      ]
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "git_repository",
            "local_workspace",
            "chat",
            "website"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "internal"
          ]
        },
        "artifact_kind": {
          "enum": [
            "cargo_manifest",
            "diary",
            "document",
            "gui",
            "instructions",
            "ontology",
            "project_roadmap",
            "repository_content",
            "website"
          ]
        },
        "actor": {
          "enum": [
            "ai_agent",
            "human",
            "automation"
          ]
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gui": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "persistence": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "background_workers": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "external_input": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "cli": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "network": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "public_release": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "diagnostics": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "configuration": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "ci": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "performance": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        },
        "release_artifacts": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_applicable"
          ]
        }
      }
    }
  }
}
