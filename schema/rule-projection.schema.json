{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/nomos/blob/main/schema/rule-projection.schema.json",
  "title": "Nomos derived agent-consumption projection",
  "description": "An inert, reproducible, nonnormative description of an explicitly chosen source selection evaluated against typed project facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "source",
    "context",
    "approval",
    "controls",
    "decisions",
    "conflicts",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "rule_projection"
    },
    "status": {
      "enum": [
        "preview",
        "approved"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "profile_id",
        "profile_version",
        "rule_ids",
        "digest_sha256",
        "registry_revision_sha256"
      ],
      "properties": {
        "type": {
          "enum": [
            "profile",
            "rules"
          ]
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          }
        },
        "digest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_revision_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of all canonical registry identities, versions, publication states and source fingerprints; distinguishes registry revisions without requiring online Git access."
        }
      }
    },
    "context": {
      "$ref": "project-context.schema.json"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_selection_confirmed",
        "project_context_reviewed",
        "projection_confirmed"
      ],
      "properties": {
        "source_selection_confirmed": {
          "type": "boolean"
        },
        "project_context_reviewed": {
          "type": "boolean"
        },
        "projection_confirmed": {
          "type": "boolean"
        }
      }
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "rule_version",
          "source_sha256",
          "decision",
          "reason",
          "situation_ids",
          "intent_ids"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^NOM-[0-9]{4,}$"
          },
          "rule_version": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decision": {
            "enum": [
              "include",
              "exclude",
              "conditional",
              "blocked",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "situation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intent_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindings",
        "overrides"
      ],
      "properties": {
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "reviewed",
              "source_sha256",
              "features",
              "covers_all_clauses"
            ],
            "additionalProperties": false,
            "properties": {
              "reviewed": {
                "const": true
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "features": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "key",
                    "required"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "required": {
                      "enum": [
                        "yes",
                        "no",
                        "unknown",
                        "not_applicable"
                      ]
                    }
                  }
                }
              },
              "covers_all_clauses": {
                "type": "boolean"
              }
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "decision",
              "reason_code"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^NOM-[0-9]{4,}$"
              },
              "decision": {
                "const": "exclude"
              },
              "reason_code": {
                "enum": [
                  "out_of_scope",
                  "explicitly_deferred",
                  "already_satisfied"
                ]
              }
            }
          }
        }
      }
    }
  }
}
