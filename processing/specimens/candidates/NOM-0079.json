{
  "id": "NOM-0079",
  "version": "0.1.0",
  "title": "Do not invent local repository paths",
  "summary": "Do not fabricate, infer, or substitute an unverified filesystem path for a project when writing or running a YAML-specified job against a local Git repository.",
  "statement": "Do not fabricate, infer, or substitute an unverified filesystem path for a project when writing or running a YAML-specified job against a local Git repository.",
  "rationale": "Public-safe, independently reviewed operational rule.",
  "language": "en",
  "status": "draft",
  "norm": {
    "kind": "prohibition",
    "predicate": {
      "action": "invent",
      "object": "unverified_repository_path",
      "target": "local_repository_yaml_job"
    },
    "permission_strength": "not_applicable",
    "conditions": [
      "Job targets an existing explicitly authorized local repository."
    ],
    "exceptions": [
      "Does not authorize changing unrelated or substitute repositories."
    ],
    "bounds": {
      "quantifier": "unspecified",
      "interpretation": "unspecified",
